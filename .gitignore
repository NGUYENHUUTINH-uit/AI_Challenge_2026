# Virtual Environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribution / packaging
*.egg-info/
dist/
build/

# =============================================
# Data & Model files — GIU CAU TRUC, IGNORE NOI DUNG
# Chi commit .gitkeep de giu thu muc tren Git
# =============================================

# Keyframes (anh .jpg - hang GB)
data/processed/keyframes/*
!data/processed/keyframes/.gitkeep
data/processed/keyframes_clean/*
!data/processed/keyframes_clean/.gitkeep

# Map keyframes (.csv - gitignored chung)
data/processed/map-keyframes/*
!data/processed/map-keyframes/.gitkeep

# Media info (.json tu tao)
data/processed/media-info/*
!data/processed/media-info/.gitkeep

# Objects detection (.json)
data/processed/objects/*
!data/processed/objects/.gitkeep

# Video goc
data/raw_videos/
data/sample_videos/

# DATA BTC CHINH THUC (12GB+, moi nguoi tu tai ve may rieng)
data/btc/

# CLIP features & FAISS index (sinh ra boi pipeline)
*.npy
*.faiss

# Model weights
*.pt
*.pth
*.bin
*.onnx

# metadata.json duoc GIT TRACK (quan trong, nhe, can chia se)
# !data/processed/metadata.json   <- mac dinh da track vi khong bi ignore

# =============================================
# Logs
# =============================================
*.log
logs/

# Environment variables (chua API keys - tuyet doi khong commit)
.env
.env.local

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

